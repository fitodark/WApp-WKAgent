# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Proveedor del modelo de IA (chat) ──────────────────────
# Opciones: claudeapi | openrouter
PROVIDER_CHAT=claudeapi

# ── Anthropic API (si PROVIDER_CHAT=claudeapi) ────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_MAX_TOKENS=1024

# ── OpenRouter (si PROVIDER_CHAT=openrouter) ──────────────
# Obtener key en: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Elegir modelo según costo/calidad en https://openrouter.ai/models
# OPENROUTER_MODEL=
# OPENROUTER_MAX_TOKENS=1024

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: whapi | meta | twilio | openwa
WHATSAPP_PROVIDER=whapi

# ── Whapi.cloud (si WHATSAPP_PROVIDER=whapi) ──────────────
# Obtener en: https://whapi.cloud (plan gratis disponible)
WHAPI_TOKEN=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# Configurar en: https://twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── OpenWA (si WHATSAPP_PROVIDER=openwa) ──────────────────
# Servidor self-hosted basado en whatsapp-web.js (https://github.com/rmyndharis/OpenWA)
# OPENWA_BASE_URL=http://localhost:2785
# OPENWA_API_KEY=
# OPENWA_SESSION_ID=default

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development
# Segundos de inactividad que se esperan para juntar mensajes seguidos del mismo
# cliente en una sola respuesta, en vez de contestar cada uno por separado.
MENSAJE_DEBOUNCE_SEGUNDOS=15

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
